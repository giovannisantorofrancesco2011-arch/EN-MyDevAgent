# ---- LLM backend (any OpenAI-compatible server) ----
# Ollama (default)        -> http://localhost:11434/v1
# LM Studio               -> http://localhost:1234/v1
# vLLM                    -> http://localhost:8001/v1
# llama.cpp llama-server  -> http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Hardware profile: cpu | gpu8 | gpu16 | gpu24
MYDEVAGENT_PROFILE=gpu8

# Optional per-tier model overrides (leave empty to use the profile)
# MYDEVAGENT_MODEL_MAIN=qwen2.5-coder:7b
# MYDEVAGENT_MODEL_FAST=qwen2.5-coder:1.5b
# MYDEVAGENT_MODEL_REASONING=qwen3:8b
# MYDEVAGENT_MODEL_VISION=qwen2.5vl:7b
# MYDEVAGENT_MODEL_EMBED=nomic-embed-text

# ---- Web search (all optional: without keys it uses DuckDuckGo) ----
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_URL=
# Force offline mode (no network calls to the internet)
# MYDEVAGENT_OFFLINE=1

# ---- Skill ----
# Extra skill folders besides .mydevagent/skills and ~/.claude/skills (separated by ; on Windows, : elsewhere)
# MYDEVAGENT_SKILLS_DIRS=C:\Users\Santoro\BluAgent\skills
# Extra plugin folders (Claude Code format), besides /plugin install
# MYDEVAGENT_PLUGINS_DIRS=
# Browser for website previews (it usually finds one on its own: Edge, Chrome or Chromium)
# MYDEVAGENT_BROWSER=

# ---- OpenAI-compatible server ----
# If you expose the server beyond localhost (e.g. for Cursor), set a key!
MYDEVAGENT_API_KEY=
