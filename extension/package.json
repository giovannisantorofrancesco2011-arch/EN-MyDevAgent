{
  "name": "mydevagent",
  "displayName": "MyDevAgent",
  "description": "Vio, your local coding agent: chat, changes you confirm, Ctrl+I and Tab. Runs on Ollama, no cloud.",
  "version": "0.2.1",
  "publisher": "mydevagent",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/giovannisantorofrancesco2011-arch/EN-MyDevAgent"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Themes"
  ],
  "keywords": [
    "ai",
    "agent",
    "ollama",
    "local",
    "english"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted folders Vio does not read, edit or run anything: it tells you and lets you choose."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mydevagent",
          "title": "MyDevAgent",
          "icon": "media/vio-activity.svg"
        }
      ]
    },
    "views": {
      "mydevagent": [
        {
          "type": "webview",
          "id": "mydevagent.chat",
          "name": "Vio"
        }
      ]
    },
    "commands": [
      {
        "command": "mydevagent.focus",
        "title": "Open Vio's chat",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.inlineEdit",
        "title": "Edit with Vio",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.acceptInline",
        "title": "Keep Vio's edit",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.rejectInline",
        "title": "Discard Vio's edit",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.approve",
        "title": "Apply the change",
        "category": "MyDevAgent",
        "icon": "$(check)"
      },
      {
        "command": "mydevagent.reject",
        "title": "Reject the change",
        "category": "MyDevAgent",
        "icon": "$(close)"
      },
      {
        "command": "mydevagent.stop",
        "title": "Stop Vio",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.undo",
        "title": "Undo Vio's last changes",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.stats",
        "title": "Statistics",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.newChat",
        "title": "New chat",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.toggleTab",
        "title": "Toggle Tab completion",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.restart",
        "title": "Restart MyDevAgent",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.install",
        "title": "Install MyDevAgent (Python, Ollama and models)",
        "category": "MyDevAgent"
      },
      {
        "command": "mydevagent.showLog",
        "title": "Show the log",
        "category": "MyDevAgent"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mydevagent.approve",
          "when": "resourceScheme == mydevagent-proposal",
          "group": "navigation@1"
        },
        {
          "command": "mydevagent.reject",
          "when": "resourceScheme == mydevagent-proposal",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "mydevagent.inlineEdit",
          "when": "editorTextFocus && !editorReadonly",
          "group": "0_mydevagent@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mydevagent.approve",
          "when": "mydevagent.pendingApproval"
        },
        {
          "command": "mydevagent.reject",
          "when": "mydevagent.pendingApproval"
        },
        {
          "command": "mydevagent.acceptInline",
          "when": "mydevagent.inlinePending"
        },
        {
          "command": "mydevagent.rejectInline",
          "when": "mydevagent.inlinePending"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mydevagent.focus",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "mydevagent.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "mydevagent.acceptInline",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && mydevagent.inlinePending"
      },
      {
        "command": "mydevagent.rejectInline",
        "key": "escape",
        "when": "editorTextFocus && mydevagent.inlinePending && !suggestWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "command": "mydevagent.stop",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "mydevagent.busy"
      }
    ],
    "configuration": {
      "title": "MyDevAgent",
      "properties": {
        "mydevagent.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder where MyDevAgent is installed (the one with `.venv`). Empty: Vio looks for it by itself.",
          "scope": "machine"
        },
        "mydevagent.profile": {
          "type": "string",
          "enum": [
            "",
            "cpu",
            "gpu8",
            "gpu16",
            "gpu24"
          ],
          "enumDescriptions": [
            "The one in MyDevAgent's .env file",
            "CPU only",
            "8 GB graphics card",
            "16 GB graphics card",
            "24 GB graphics card"
          ],
          "default": "",
          "description": "Model profile (depends on your graphics card)."
        },
        "mydevagent.permissions": {
          "type": "string",
          "enum": [
            "ask",
            "auto-edit",
            "plan",
            "auto"
          ],
          "enumDescriptions": [
            "Asks for confirmation before every change and command",
            "Edits files by itself, asks before commands",
            "Reads and proposes a plan, changes nothing",
            "Does everything by itself inside the project folder"
          ],
          "default": "ask",
          "description": "What Vio can do without asking your permission."
        },
        "mydevagent.team": {
          "type": "string",
          "enum": [
            "auto",
            "fast",
            "balanced",
            "deep",
            "ultra-deep"
          ],
          "default": "auto",
          "description": "How many agents work on each request (auto: Vio chooses)."
        },
        "mydevagent.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Suggests code while you type: press Tab to accept it."
        },
        "mydevagent.tab.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for Tab (empty: the profile's fast model). Recommended: `qwen2.5-coder:1.5b-base`."
        },
        "mydevagent.tab.delay": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 2000,
          "description": "Milliseconds of pause in typing before asking for a suggestion."
        },
        "mydevagent.autoDiff": {
          "type": "boolean",
          "default": true,
          "description": "When Vio wants to change a file, open the before/after comparison in the editor right away."
        },
        "mydevagent.saveBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "Save open files before sending a request, so Vio sees the latest version."
        }
      }
    },
    "themes": [
      {
        "label": "MyDevAgent Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/mydevagent-dark.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "mydevagent",
        "properties": {}
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "node --test test/markdown.test.js",
    "package": "vsce package --no-dependencies -o mydevagent.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
