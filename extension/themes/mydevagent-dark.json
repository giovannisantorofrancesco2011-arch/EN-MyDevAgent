  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"],
      "settings": { "foreground": "#6e6590", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new",
        "keyword.operator.expression", "keyword.operator.logical.python", "variable.language.this", "variable.language.self",
        "variable.parameter.function.language.special.self.python"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value"],
      "settings": { "foreground": "#a78bfa" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"],
      "settings": { "foreground": "#9d8fc4" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function",
        "entity.name.method"],
      "settings": { "foreground": "#f0abfc" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class",
        "storage.type.primitive", "entity.name.namespace"],
      "settings": { "foreground": "#f9a8d4" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#a7f3d0" }
    },
    {
      "name": "Special characters in strings",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder",
        "punctuation.definition.template-expression"],
      "settings": { "foreground": "#67e8f9" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#e7e1f5" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters variable"],
      "settings": { "foreground": "#fbcfe8", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property",
        "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name"],
      "settings": { "foreground": "#d8b4fe" }
    },
    {
      "name": "Decorators",
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#fdba74" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "#f472b6" }
    },
    {
      "name": "HTML and CSS attributes",
      "scope": ["entity.other.attribute-name", "support.type.property-name.css"],
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#f0abfc" }
    },
    {
      "name": "Import",
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export"],
      "settings": { "foreground": "#c084fc", "fontStyle": "italic" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#c084fc", "fontStyle": "bold" }
    },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#93c5fd" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#86efac" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#fda4af" } },
    { "scope": ["markup.changed", "meta.diff.range"], "settings": { "foreground": "#c084fc" } },
    { "scope": "invalid", "settings": { "foreground": "#fb7185" } }
  ],
  "semanticTokenColors": {
    "namespace": "#f9a8d4",
    "class": "#f9a8d4",
    "type": "#f9a8d4",
    "interface": "#f9a8d4",
    "enum": "#f9a8d4",
    "typeParameter": "#f9a8d4",
    "function": "#f0abfc",
    "method": "#f0abfc",
    "decorator": "#fdba74",
    "parameter": { "foreground": "#fbcfe8", "italic": true },
    "property": "#d8b4fe",
    "enumMember": "#fcd34d",
    "selfParameter": "#c084fc"
  }
}
